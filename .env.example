# Google Cloud > APIs & Services > Credentials > OAuth client (Web application)
# Authorized redirect URI: http://localhost:5173/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Generate independently: openssl rand -base64 32
AUTH_SECRET=
API_KEY_ENCRYPTION_KEY=

# Required for production. Match the externally visible HTTPS origin.
# ORIGIN=https://monitor.example.com
# AUTH_TRUST_HOST=true

# Durable, private SQLite location; mount this directory in production.
DATABASE_PATH=data/situation-monitor.sqlite
